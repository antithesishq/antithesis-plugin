#!/usr/bin/env python3
"""Check the file references inside every skill.

Skills name their bundled files as paths from the skill root, usually in backticks
(`references/triage/MODULE.md`) and sometimes as Markdown links. For each skill this
fails when a referenced file doesn't exist, or when a bundled file can't be reached
from SKILL.md by following references, at any depth.

    scripts/check-references
"""
import os
import re
import sys
from pathlib import Path

ROOT = Path(__file__).resolve().parent.parent
SKILL_GLOBS = ["plugins/*/skills/*/SKILL.md", ".agents/skills/*/SKILL.md"]
BUNDLED_DIRS = ("references", "scripts", "assets")
# A path from the skill root, in backticks or as a Markdown link target.
REFERENCE = re.compile(r"(?:`|\]\()((?:%s)/[^`)\s#]+)" % "|".join(BUNDLED_DIRS))
PLACEHOLDER = re.compile(r"[<>{}*]")
ANNOTATE = bool(os.environ.get("GITHUB_ACTIONS"))


def report(path: Path, line: int, message: str) -> None:
    rel = path.relative_to(ROOT)
    if ANNOTATE:
        print(f"::error file={rel},line={line},title=check-references::{message}")
    else:
        print(f"{rel}:{line}: {message}")


def references(path: Path):
    for number, text in enumerate(path.read_text().splitlines(), 1):
        for match in REFERENCE.finditer(text):
            target = match.group(1).rstrip(".,:;")
            if not PLACEHOLDER.search(target):
                yield number, target


def check(skill_md: Path) -> int:
    skill = skill_md.parent
    bundled = {
        p.relative_to(skill).as_posix()
        for d in BUNDLED_DIRS
        for p in (skill / d).rglob("*")
        if p.is_file()
    }
    problems = 0
    reached, queue = set(), [skill_md]
    while queue:
        source = queue.pop()
        if source in reached:
            continue
        reached.add(source)
        if source.suffix != ".md":
            continue
        for line, target in sorted(set(references(source))):
            path = skill / target
            if path.is_file():
                queue.append(path)
            # A repo-internal skill may name the repo's own files, such as `scripts/set-version`.
            elif not path.is_dir() and not (ROOT / target).exists():
                report(source, line, f"`{target}` does not exist in skill `{skill.name}`")
                problems += 1
    for rel in sorted(bundled - {p.relative_to(skill).as_posix() for p in reached}):
        report(skill / rel, 1, f"`{rel}` is not reachable from {skill.name}/SKILL.md")
        problems += 1
    return problems


def main() -> int:
    skills = sorted(p for g in SKILL_GLOBS for p in ROOT.glob(g))
    problems = sum(check(s) for s in skills)
    if not problems:
        print(f"{len(skills)} skills: every reference resolves and every file is reachable")
    return 1 if problems else 0


if __name__ == "__main__":
    sys.exit(main())
